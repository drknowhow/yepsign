{
  "manifest_version": 3,
  "name": "YepSign: Sign PDFs by Hand",
  "short_name": "YepSign",
  "version": "0.9.0",
  "description": "Sign PDFs in your own handwriting with a mouse, pen or finger. No printing or scanning, and your files stay on your computer.",
  "homepage_url": "https://drknowhow.github.io/yepsign/",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Sign a PDF with YepSign",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
